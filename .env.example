# Copy to .env.local for `next dev`. Everything here is optional while UPSTREAM_MODE=mock.
UPSTREAM_MODE=mock
VENUE_TIMEZONE=Australia/Brisbane
# Comma-separated secret bearer tokens, 32+ characters each. Generate with: openssl rand -hex 32
MCP_BEARER_TOKENS=
# Public token for the fictional data (mock mode only). Set to "none" to disable it.
MCP_PUBLIC_DEMO_TOKEN=lakeside-demo-readonly
RATE_LIMIT_PER_MINUTE=60
# Extra browser origins allowed to call /mcp (the site's own origin is always allowed)
ALLOWED_ORIGINS=
# Live mode only (UPSTREAM_MODE=live). Never commit real values.
CONNECTEAM_CLIENT_ID=
CONNECTEAM_CLIENT_SECRET=
ROLLER_CLIENT_ID=
ROLLER_CLIENT_SECRET=
