# Copy to .env.local for `next dev`. Everything here is optional while UPSTREAM_MODE=mock.
# mock or live. Required (no default) as soon as API credentials or MCP_BEARER_TOKENS are set.
UPSTREAM_MODE=mock
VENUE_TIMEZONE=Australia/Brisbane
# Comma-separated secret bearer tokens, 32+ characters each. Create one with: openssl rand -hex 32
MCP_BEARER_TOKENS=
# Public token for the fictional data (mock mode only). Set to "none" to disable it.
MCP_PUBLIC_DEMO_TOKEN=lakeside-demo-readonly
RATE_LIMIT_PER_MINUTE=60
# Exact origins of pages that may call /mcp from a browser. The deployment's own Vercel URLs are added automatically.
ALLOWED_ORIGINS=
# Data the tools may return (policy choices; see README)
PAY_RATE_MIN_GROUP=3
STAFF_EXTRA_FIELDS=
INCLUDE_TIMESHEET_NOTES=false
# Live mode only (UPSTREAM_MODE=live). Never commit real values.
CONNECTEAM_CLIENT_ID=
CONNECTEAM_CLIENT_SECRET=
ROLLER_CLIENT_ID=
ROLLER_CLIENT_SECRET=
